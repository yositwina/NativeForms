    <fields>
        <fullName>NativeForms_Secret_Code__c</fullName>
        <description>Stores the latest NativeForms verification number for support and admin visibility.</description>
        <externalId>false</externalId>
        <inlineHelpText>Latest NativeForms 6-digit verification number sent to this Contact.</inlineHelpText>
        <label>NativeForms Verification Number</label>
        <length>6</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
