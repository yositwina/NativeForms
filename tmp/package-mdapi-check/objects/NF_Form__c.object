<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stable business identity for a TwinaForms form.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>NF Form</label>
    <nameField>
        <displayFormat>FORM-{0000}</displayFormat>
        <label>Form Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>NF Forms</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Business_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Optional business owner separate from the Salesforce record owner.</description>
        <inlineHelpText>Optional business owner.</inlineHelpText>
        <label>Business Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipLabel>NF Forms Business Owner</relationshipLabel>
        <relationshipName>NFFormsBusinessOwner</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Category__c</fullName>
        <description>Optional category or grouping value for the form.</description>
        <inlineHelpText>Optional form category.</inlineHelpText>
        <label>Category</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Current_Draft_Version__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Current draft version for the form.</description>
        <inlineHelpText>Points to the version currently being edited.</inlineHelpText>
        <label>Current Draft Version</label>
        <referenceTo>NF_Form_Version__c</referenceTo>
        <relationshipLabel>Forms as Current Draft</relationshipLabel>
        <relationshipName>FormsAsCurrentDraft</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Current_Published_Version__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Current published version for the form.</description>
        <inlineHelpText>Points to the live published version.</inlineHelpText>
        <label>Current Published Version</label>
        <referenceTo>NF_Form_Version__c</referenceTo>
        <relationshipLabel>Forms as Current Published</relationshipLabel>
        <relationshipName>FormsAsCurrentPublished</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Internal description or notes about the form.</description>
        <inlineHelpText>Internal description or notes.</inlineHelpText>
        <label>Description</label>
        <length>32768</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Enable_Captcha__c</fullName>
        <defaultValue>false</defaultValue>
        <description>When enabled, published forms require a CAPTCHA challenge before submit is accepted.</description>
        <externalId>false</externalId>
        <inlineHelpText>Require Google reCAPTCHA verification on the published form before submit.</inlineHelpText>
        <label>Enable CAPTCHA</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>NF_Key__c</fullName>
        <description>Unique internal key for the form.</description>
        <externalId>false</externalId>
        <inlineHelpText>Stable internal or business key for the form.</inlineHelpText>
        <label>NF Key</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Assigned project for organizing the form in the Designer.</description>
        <externalId>false</externalId>
        <label>Project</label>
        <referenceTo>NF_Project__c</referenceTo>
        <relationshipLabel>Project Forms</relationshipLabel>
        <relationshipName>ProjectForms</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>High-level lifecycle status for the form.</description>
        <inlineHelpText>Overall form status.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Draft</fullName>
                    <default>true</default>
                    <label>Draft</label>
                </value>
                <value>
                    <fullName>Active</fullName>
                    <default>false</default>
                    <label>Active</label>
                </value>
                <value>
                    <fullName>Archived</fullName>
                    <default>false</default>
                    <label>Archived</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Theme__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Assigned reusable theme for the form.</description>
        <externalId>false</externalId>
        <label>Theme</label>
        <referenceTo>NF_Theme__c</referenceTo>
        <relationshipLabel>Themed Forms</relationshipLabel>
        <relationshipName>ThemedForms</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Description__c</columns>
        <columns>NF_Key__c</columns>
        <columns>Status__c</columns>
        <columns>Category__c</columns>
        <columns>Business_Owner__c</columns>
        <columns>Current_Draft_Version__c</columns>
        <columns>Current_Published_Version__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Debug_All_Records</fullName>
        <columns>NAME</columns>
        <columns>Description__c</columns>
        <columns>NF_Key__c</columns>
        <columns>Status__c</columns>
        <columns>Category__c</columns>
        <columns>Business_Owner__c</columns>
        <columns>Current_Draft_Version__c</columns>
        <columns>Current_Published_Version__c</columns>
        <filterScope>Everything</filterScope>
        <label>Debug - All Records</label>
    </listViews>
</CustomObject>
